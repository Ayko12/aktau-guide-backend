# База данных: SQLite по умолчанию, для PostgreSQL:
# AG_DATABASE_URL=postgresql+psycopg://aktau:aktau@localhost:5432/aktau
AG_DATABASE_URL=sqlite:///./aktau_guide.db

# Обязательно смените в production (openssl rand -hex 32)
AG_SECRET_KEY=dev-secret-change-me
AG_TOKEN_TTL_MINUTES=10080

# Адрес фронтенда (через запятую, если несколько)
AG_CORS_ORIGINS=http://localhost:5173

# Демо: вход по роли, пароли demo1234, сиды при пустой БД
AG_DEMO_MODE=true
AG_SEED_ON_STARTUP=true

# «Сегодня» для демо-данных (как TODAY во фронтенде). Пусто — реальная дата.
AG_TODAY=2026-11-22
